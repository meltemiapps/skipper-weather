    "about.privacyBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا حساب ولا تتبّع ولا تحليلات ولا إعلانات. يبقى تقدّمك وإعداداتك على هذا الجهاز ولا تُجمع أو تُشارك أبدًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konto, sporing, analyse eller reklamer. Dine fremskridt og indstillinger bliver på denne enhed og bliver aldrig indsamlet eller delt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto, kein Tracking, keine Analysen, keine Werbung. Dein Fortschritt und deine Einstellungen bleiben auf diesem Gerät und werden nie erfasst oder weitergegeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς λογαριασμό, παρακολούθηση, αναλυτικά στοιχεία ή διαφημίσεις. Η πρόοδος και οι ρυθμίσεις σας μένουν σε αυτή τη συσκευή και δεν συλλέγονται ούτε κοινοποιούνται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account, tracking, analytics or ads. Your progress and settings stay on this device and are never collected or shared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta, seguimiento, analíticas ni anuncios. Tu progreso y tus ajustes se quedan en este dispositivo y nunca se recopilan ni se comparten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei tiliä, seurantaa, analytiikkaa eikä mainoksia. Edistymisesi ja asetuksesi pysyvät tällä laitteella, eikä niitä koskaan kerätä tai jaeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de compte, de suivi, d'analyses ni de publicité. Votre progression et vos réglages restent sur cet appareil et ne sont jamais collectés ni partagés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account, tracciamento, analisi o pubblicità. I tuoi progressi e le impostazioni restano su questo dispositivo e non vengono mai raccolti né condivisi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konto, sporing, analyse eller reklame. Fremgangen og innstillingene dine blir på denne enheten og blir aldri samlet inn eller delt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen account, tracking, analyses of advertenties. Je voortgang en instellingen blijven op dit apparaat en worden nooit verzameld of gedeeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez konta, śledzenia, analityki i reklam. Twoje postępy i ustawienia pozostają na tym urządzeniu i nigdy nie są zbierane ani udostępniane."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta, rastreio, análises ou anúncios. O seu progresso e as suas definições ficam neste dispositivo e nunca são recolhidos nem partilhados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без учётной записи, отслеживания, аналитики и рекламы. Ваш прогресс и настройки хранятся только на этом устройстве и никогда не собираются и не передаются."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Без налога, праћења, аналитике и реклама. Ваш напредак и подешавања остају на овом уређају и никада се не прикупљају нити деле."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget konto, ingen spårning, analys eller reklam. Dina framsteg och inställningar stannar på den här enheten och samlas aldrig in eller delas."
          }
        }
      }
    },
