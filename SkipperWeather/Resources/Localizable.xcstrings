{
  "sourceLanguage": "en",
  "strings": {
    "about.navBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للتعلّم فقط. قد يحتوي المحتوى على أخطاء. لا تستخدم هذا التطبيق أبدًا للملاحة أو تخطيط الرحلات أو قرارات السلامة. استخدم دائمًا النشرات الجوية الرسمية واطلب تدريبًا مؤهلًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun til læring. Indholdet kan indeholde fejl. Brug aldrig denne app til navigation, sejladsplanlægning eller sikkerhedsbeslutninger. Brug altid officielle prognoser og søg kvalificeret undervisning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur zum Lernen. Inhalte können Fehler enthalten. Verwende diese App niemals zur Navigation, Törnplanung oder für Sicherheitsentscheidungen. Nutze immer offizielle Vorhersagen und eine qualifizierte Ausbildung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο για εκπαιδευτικούς σκοπούς. Το περιεχόμενο μπορεί να περιέχει λάθη. Μη χρησιμοποιείτε ποτέ την εφαρμογή για ναυσιπλοΐα, σχεδιασμό πλου ή αποφάσεις ασφαλείας. Χρησιμοποιείτε πάντα επίσημες προγνώσεις και πιστοποιημένη εκπαίδευση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For learning only. Content may contain errors. Never use this app for navigation, passage planning or safety decisions. Always use official forecasts and seek qualified instruction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para aprendizaje. El contenido puede contener errores. No uses nunca esta app para navegar, planificar travesías ni tomar decisiones de seguridad. Usa siempre previsiones oficiales y busca formación cualificada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain opiskeluun. Sisällössä voi olla virheitä. Älä koskaan käytä sovellusta navigointiin, matkan suunnitteluun tai turvallisuuspäätöksiin. Käytä aina virallisia sääennusteita ja hakeudu pätevään koulutukseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour l'apprentissage uniquement. Le contenu peut comporter des erreurs. N'utilisez jamais cette app pour naviguer, préparer une traversée ou prendre des décisions de sécurité. Utilisez toujours les prévisions officielles et suivez une formation qualifiée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo a scopo didattico. I contenuti possono contenere errori. Non usare mai questa app per la navigazione, la pianificazione delle traversate o decisioni di sicurezza. Usa sempre le previsioni ufficiali e una formazione qualificata."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun for læring. Innholdet kan inneholde feil. Bruk aldri denne appen til navigasjon, seilasplanlegging eller sikkerhetsbeslutninger. Bruk alltid offisielle værvarsler og søk kvalifisert opplæring."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen om te leren. De inhoud kan fouten bevatten. Gebruik deze app nooit voor navigatie, tochtplanning of veiligheidsbeslissingen. Gebruik altijd officiële weersverwachtingen en volg een erkende opleiding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącznie do nauki. Treści mogą zawierać błędy. Nigdy nie używaj tej aplikacji do nawigacji, planowania rejsu ani decyzji dotyczących bezpieczeństwa. Zawsze korzystaj z oficjalnych prognoz i kwalifikowanego szkolenia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas para aprendizagem. O conteúdo pode conter erros. Nunca utilize esta app para navegação, planeamento de travessias ou decisões de segurança. Utilize sempre previsões oficiais e procure formação qualificada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для обучения. Материалы могут содержать ошибки. Никогда не используйте приложение для навигации, планирования перехода или решений, связанных с безопасностью. Всегда пользуйтесь официальными прогнозами и квалифицированным обучением."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Само за учење. Садржај може да садржи грешке. Никада не користите ову апликацију за навигацију, планирање пловидбе или одлуке о безбедности. Увек користите званичне прогнозе и квалификовану обуку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast för lärande. Innehållet kan innehålla fel. Använd aldrig appen för navigering, segelplanering eller säkerhetsbeslut. Använd alltid officiella prognoser och sök kvalificerad utbildning."
          }
        }
      }
    },
