    "about.unofficialBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا التطبيق وسيلة دراسية مستقلة وغير رسمية من إعداد فرد. وهو غير تابع أو معتمد أو مموّل من الجمعية الملكية لليخوت Royal Yachting Association (RYA) ولا مرتبط بها، ولا بأي منظمة إبحار أو مركز تدريب أو جهة اختبار أو خدمة أرصاد جوية أخرى. المؤلف ليس مدرّبًا معتمدًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne app er et uafhængigt, uofficielt studieværktøj lavet af en privatperson. Den er ikke tilknyttet, godkendt, sponsoreret af eller forbundet med Royal Yachting Association (RYA) eller nogen anden sejlerorganisation, skole, eksamensinstans eller meteorologisk tjeneste. Forfatteren er ikke certificeret instruktør."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App ist eine unabhängige, inoffizielle Lernhilfe einer Privatperson. Sie ist weder mit der Royal Yachting Association (RYA) noch mit einer anderen Segelorganisation, Ausbildungsstätte, Prüfungsstelle oder einem Wetterdienst verbunden, von ihnen unterstützt, gesponsert oder anerkannt. Der Autor ist kein zertifizierter Ausbilder."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η εφαρμογή είναι ένα ανεξάρτητο, ανεπίσημο βοήθημα μελέτης από ιδιώτη. Δεν συνδέεται, δεν εγκρίνεται, δεν χρηματοδοτείται και δεν σχετίζεται με τον Royal Yachting Association (RYA) ή οποιονδήποτε άλλο ιστιοπλοϊκό οργανισμό, σχολή, εξεταστικό φορέα ή μετεωρολογική υπηρεσία. Ο δημιουργός δεν είναι πιστοποιημένος εκπαιδευτής."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is an independent, unofficial study aid made by a private individual. It is not affiliated with, endorsed by, sponsored by or associated with the Royal Yachting Association (RYA) or any other sailing organisation, training centre, examining body or meteorological service. The author is not a certified instructor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app es una ayuda de estudio independiente y no oficial creada por un particular. No está afiliada, respaldada, patrocinada ni asociada con la Royal Yachting Association (RYA) ni con ninguna otra organización náutica, escuela, organismo examinador o servicio meteorológico. El autor no es un instructor certificado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä sovellus on yksityishenkilön tekemä riippumaton, epävirallinen opiskelun apuväline. Se ei ole sidoksissa Royal Yachting Associationiin (RYA) eikä mihinkään muuhun purjehdusjärjestöön, koulutuskeskukseen, tutkintoelimeen tai sääpalveluun, eivätkä ne ole hyväksyneet tai sponsoroineet sitä. Tekijä ei ole sertifioitu kouluttaja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app est une aide à l'étude indépendante et non officielle, créée par un particulier. Elle n'est ni affiliée, ni approuvée, ni parrainée par la Royal Yachting Association (RYA), ni associée à elle ou à toute autre organisation nautique, école, organisme d'examen ou service météorologique. L'auteur n'est pas un moniteur certifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app è un ausilio allo studio indipendente e non ufficiale, realizzato da un privato. Non è affiliata, approvata, sponsorizzata né associata alla Royal Yachting Association (RYA) o ad altre organizzazioni veliche, scuole, enti d'esame o servizi meteorologici. L'autore non è un istruttore certificato."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne appen er et uavhengig, uoffisielt studiehjelpemiddel laget av en privatperson. Den er ikke tilknyttet, godkjent, sponset av eller forbundet med Royal Yachting Association (RYA) eller noen annen seilorganisasjon, skole, eksamensinstans eller meteorologisk tjeneste. Forfatteren er ikke sertifisert instruktør."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze app is een onafhankelijk, onofficieel studiehulpmiddel van een particulier. De app is niet gelieerd aan, goedgekeurd of gesponsord door, of verbonden met de Royal Yachting Association (RYA) of een andere zeilorganisatie, opleiding, examenorganisatie of meteorologische dienst. De maker is geen gecertificeerd instructeur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta aplikacja to niezależna, nieoficjalna pomoc naukowa stworzona przez osobę prywatną. Nie jest powiązana, zatwierdzona, sponsorowana ani związana z Royal Yachting Association (RYA) ani z żadną inną organizacją żeglarską, szkołą, instytucją egzaminacyjną czy służbą meteorologiczną. Autor nie jest certyfikowanym instruktorem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app é um auxiliar de estudo independente e não oficial, criado por um particular. Não é afiliada, aprovada, patrocinada nem associada à Royal Yachting Association (RYA) nem a qualquer outra organização náutica, escola, entidade examinadora ou serviço meteorológico. O autor não é um instrutor certificado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приложение — независимое неофициальное учебное пособие, созданное частным лицом. Оно не связано, не одобрено, не спонсируется и не ассоциировано с Royal Yachting Association (RYA) или любой другой парусной организацией, школой, экзаменационным органом или метеорологической службой. Автор не является сертифицированным инструктором."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ова апликација је независно, незванично помагало за учење које је направило приватно лице. Није повезана са, одобрена, спонзорисана нити придружена организацији Royal Yachting Association (RYA) ни било којој другој једриличарској организацији, школи, испитном телу или метеоролошкој служби. Аутор није сертификовани инструктор."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här appen är ett oberoende, inofficiellt studiestöd gjort av en privatperson. Den är inte ansluten till, godkänd, sponsrad av eller associerad med Royal Yachting Association (RYA) eller någon annan seglarorganisation, skola, examinerande organ eller meteorologisk tjänst. Upphovspersonen är inte certifierad instruktör."
          }
        }
      }
    },
