    "about.openSourceBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشيفرة المصدرية منشورة على GitHub بموجب ترخيص MIT."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kildekoden er offentliggjort på GitHub under MIT-licensen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Quellcode ist auf GitHub unter der MIT-Lizenz veröffentlicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο πηγαίος κώδικας δημοσιεύεται στο GitHub με την άδεια MIT."
          }
        },
        "en": {
          "stringUnit": {
